        {
          "name": "5.3 Exportar CSV",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rfcEmisor\": \"{{rfc_emisor}}\",\n  \"fechaInicioRecepcion\": \"{{fecha_inicio}}\",\n  \"fechaFinalRecepcion\": \"{{fecha_fin}}\",\n  \"tipoDocumento\": \"I\"\n}"
            },
            "url": {
              "raw": "{{fiscal_api_url}}/invoices/export/csv",
              "host": ["{{fiscal_api_url}}"],
              "path": ["invoices", "export", "csv"]
            },
            "description": "Exportar resultados a CSV"
          },
          "response": []
        },
        {
          "name": "5.4 Exportar XLSX (2 Hojas)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "es"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rfcEmisor\": \"{{rfc_emisor}}\",\n  \"fechaInicioRecepcion\": \"{{fecha_inicio}}\",\n  \"fechaFinalRecepcion\": \"{{fecha_fin}}\",\n  \"tipoDocumento\": \"I\"\n}"
            },
            "url": {
              "raw": "{{fiscal_api_url}}/invoices/export/xlsx",
              "host": ["{{fiscal_api_url}}"],
              "path": ["invoices", "export", "xlsx"]
            },
            "description": "Exportar a XLSX con 2 hojas:\n- Hoja 1: Facturas encontradas\n- Hoja 2: Notas de Credito relacionadas\n\nResponse: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet (archivo binario)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Via BFF",
      "item": [
