      "get": {
        "tags": [
          "Rebates"
        ],
        "summary": "Export published rebates to CSV",
        "description": "Generate CSV file with all published rebates (status = 2)",
        "produces": [
          "text/csv"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "CSV file generated",
            "schema": {
              "type": "string",
              "format": "binary"
            }
          }
        }
      }
    },
    "/rebates/vendor/{vendorNumber}": {
      "get": {
        "tags": [
          "Rebates"
        ],
        "summary": "Get rebates by vendor number",
        "description": "Retrieve all rebates for a specific vendor",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "vendorNumber",
            "in": "path",
            "required": true,
            "description": "Vendor identifier",
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "List of rebates for vendor",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Rebate"
              }
            }
          },
          "400": {
            "description": "Invalid vendor number"
          }
        }
      }
    },
    "/rebates/search": {
      "get": {
        "tags": [
          "Rebates"
        ],
        "summary": "Search rebates with dynamic filters (Criteria API equivalent)",
        "description": "Advanced search endpoint supporting multiple filters.",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "vendorNumber",
            "in": "query",
            "required": false,
            "description": "Filter by exact vendor number",
            "type": "integer"
          },
          {
            "name": "documentNumber",
            "in": "query",
            "required": false,
            "description": "Filter by document number (LIKE search - partial match)",
            "type": "string"
          },
          {
            "name": "sapDocument",
            "in": "query",
            "required": false,
            "description": "Filter by SAP document (LIKE search - partial match)",
            "type": "string"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by status code (1=pending, 2=published)",
            "type": "integer"
          },
          {
            "name": "periodId",
            "in": "query",
            "required": false,
            "description": "Filter by period identifier",
            "type": "integer"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results per page (max 1000)",
            "type": "integer"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (0-indexed)",
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching rebates",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Rebate"
              }
            }
          },
          "400": {
            "description": "Invalid filter parameters"
          }
        }
      }
    },
    "/rebates/export/csv": {
      "get": {
        "tags": [
          "Rebates"
        ],
        "summary": "Export filtered rebates to CSV",
        "description": "Generate CSV file with rebates matching the provided filters. Supports all search filters from /rebates/search endpoint.",
        "produces": [
          "text/csv"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "vendorNumber",
            "in": "query",
            "required": false,
            "description": "Filter by exact vendor number",
            "type": "integer"
          },
          {
            "name": "documentNumber",
            "in": "query",
            "required": false,
            "description": "Filter by document number (LIKE search)",
            "type": "string"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by status code",
            "type": "integer"
          },
          {
            "name": "periodId",
            "in": "query",
            "required": false,
            "description": "Filter by period identifier",
            "type": "integer"
          },
          {
            "name": "dueDateFrom",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date"
          },
          {
            "name": "dueDateTo",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date"
          }
        ],
        "responses": {
          "200": {
            "description": "CSV file generated",
            "schema": {
              "type": "string",
              "format": "binary"
            }
          }
        }
      }
    }
