{
  "info": {
    "name": "STM-323 — Facturas — Filtro Seguridad",
    "description": "Pruebas de filtro de seguridad por atributo de usuario en Facturas (fiscal-api).\n\nPre-requisitos:\n- fiscal-api levantado en :8082 con security.enabled=true\n- util-api levantado en :3712\n- Datos seed con usuarios sb000001..5\n\nJWTs alg=none (sin firma). En uat/prod GCP gateway valida firma RSA.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082/api", "type": "string" },
    { "key": "jwtFernando", "value": "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJzYjAwMDAwMSJ9.", "type": "string" },
    { "key": "jwtAna",      "value": "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJzYjAwMDAwMiJ9.", "type": "string" },
    { "key": "jwtJose",     "value": "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJzYjAwMDAwMyJ9.", "type": "string" },
    { "key": "jwtIvan",     "value": "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJzYjAwMDAwNSJ9.", "type": "string" }
  ],
  "item": [
    {
      "name": "Escenario 1 — FERNANDO (ATR001=11111)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwtFernando}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"page\": 0, \"size\": 20}" },
        "url": {
          "raw": "{{baseUrl}}/invoices/search",
          "host": ["{{baseUrl}}"],
          "path": ["invoices", "search"]
        },
        "description": "sub=sb000001. ATR001=11111. Solo facturas con addendum.supplier_number=11111."
      }
    },
    {
      "name": "Escenario 2 — JOSE (ATR001=11111,22222)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwtJose}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"page\": 0, \"size\": 20}" },
        "url": {
          "raw": "{{baseUrl}}/invoices/search",
          "host": ["{{baseUrl}}"],
          "path": ["invoices", "search"]
        },
        "description": "sub=sb000003. Facturas de proveedor 11111 ó 22222."
      }
    },
    {
      "name": "Escenario 3 — Iván (ATR001=-1)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwtIvan}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"page\": 0, \"size\": 20}" },
        "url": {
          "raw": "{{baseUrl}}/invoices/search",
          "host": ["{{baseUrl}}"],
          "path": ["invoices", "search"]
        },
        "description": "sub=sb000005. ATR001=-1 → todas las facturas."
      }
    },
    {
      "name": "Escenario 4 — ANA sin ATR001 → WRN7029",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwtAna}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"page\": 0, \"size\": 20}" },
        "url": {
          "raw": "{{baseUrl}}/invoices/search",
          "host": ["{{baseUrl}}"],
          "path": ["invoices", "search"]
        },
        "description": "sub=sb000002. Sin ATR001 → HTTP 400 WRN7029."
      }
    },
    {
      "name": "Escenario 5 — Spoof intentado (x-user-vendors=-1)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwtFernando}}" },
          { "key": "x-user-vendors", "value": "-1" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"page\": 0, \"size\": 20}" },
        "url": {
          "raw": "{{baseUrl}}/invoices/search",
          "host": ["{{baseUrl}}"],
          "path": ["invoices", "search"]
        },
        "description": "Cliente intenta spoofear x-user-vendors=-1. SecurityContextFilter sobrescribe header con valor calculado del JWT (FERNANDO=11111). Filtro sigue activo a 11111."
      }
    }
  ]
}
