							"path": ["message", "BUS002", "format"]
						},
						"description": "Obtiene un mensaje con placeholders sustituidos. Usar query param 'params' para pasar valores."
					},
					"response": []
				},
				{
					"name": "Obtener catalogo por ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/id/1",
