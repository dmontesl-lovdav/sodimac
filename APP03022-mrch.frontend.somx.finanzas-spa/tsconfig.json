{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "DOM",
            "ES2020"
        ],
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "ignoreDeprecations": "6.0",
        "strict": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "paths": {
            "@/*": [
                "src/*"
            ],
            "@assets/*": [
                "src/assets/*"
            ],
            "@shared/*": [
                "src/shared/*"
            ],
            "@features/*": [
                "src/features/*"
            ],
            "@configuration/*": [
                "src/configuration/*"
            ],
            "@domain/*": [
                "src/domain/*"
            ],
            "@models/*": [
                "src/models/*"
            ],
            "@security/*": [
                "src/security/*"
            ],
            "@store/*": [
                "src/store/*"
            ],
            "@types/*": [
                "src/types/*"
            ]
        }
    },
    "include": [
        "src"
    ]
}