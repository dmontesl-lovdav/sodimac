{
	"info": {
		"_postman_id": "stm-1229-parameters-bff",
		"name": "STM-1229 - Parameters BFF",
		"description": "Coleccion para probar los endpoints de parametros via BFF Utilerias.\n\nTicket: STM-1229\nRelacionado: STM-1212 (modelo ER), STM-1213 (backend)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:3712/api",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Parametros - CRUD",
			"item": [
				{
					"name": "GET - Listar parametros",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/parameters",
							"host": ["{{base_url}}"],
							"path": ["parameters"]
						},
						"description": "Obtiene todos los parametros con paginacion"
					}
				},
				{
					"name": "GET - Listar con filtros",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/parameters?idModule=1&status=1&page=1&limit=10",
							"host": ["{{base_url}}"],
							"path": ["parameters"],
							"query": [
								{
									"key": "idModule",
									"value": "1",
									"description": "Filtrar por modulo"
								},
								{
									"key": "status",
									"value": "1",
									"description": "1=Activo, 0=Inactivo"
								},
								{
									"key": "page",
									"value": "1",
									"description": "Numero de pagina"
								},
								{
									"key": "limit",
									"value": "10",
									"description": "Registros por pagina"
								}
							]
						},
						"description": "Obtiene parametros con filtros opcionales"
					}
				},
				{
					"name": "GET - Obtener parametro por ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/parameters/1",
							"host": ["{{base_url}}"],
							"path": ["parameters", "1"]
						},
						"description": "Obtiene un parametro especifico por su ID"
					}
				},
				{
					"name": "POST - Crear parametro",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"idModule\": 1,\n    \"idType\": 1,\n    \"name\": \"NUEVO_PARAMETRO\",\n    \"description\": \"Descripcion del parametro\",\n    \"value\": \"valor_inicial\",\n    \"version\": 1.0,\n    \"createdBy\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/parameters",
							"host": ["{{base_url}}"],
							"path": ["parameters"]
						},
						"description": "Crea un nuevo parametro"
					}
				},
				{
					"name": "PATCH - Actualizar metadatos",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"description\": \"Nueva descripcion del parametro\",\n    \"idModule\": 2,\n    \"updatedBy\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/parameters/1",
							"host": ["{{base_url}}"],
							"path": ["parameters", "1"]
						},
						"description": "Actualiza metadatos del parametro. NO permite cambiar 'value' - usar POST /versions para eso"
					}
				},
				{
					"name": "DELETE - Eliminar parametro",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/parameters/1",
							"host": ["{{base_url}}"],
							"path": ["parameters", "1"]
						},
						"description": "Elimina un parametro por su ID"
					}
				}
			]
		},
		{
			"name": "Parametros - Estatus",
			"item": [
				{
					"name": "PATCH - Activar parametro",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": 1,\n    \"updatedBy\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/parameters/1/status",
							"host": ["{{base_url}}"],
							"path": ["parameters", "1", "status"]
						},
						"description": "Activa un parametro (status=1)"
					}
				},
				{
					"name": "PATCH - Desactivar parametro",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": 0,\n    \"updatedBy\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/parameters/1/status",
							"host": ["{{base_url}}"],
							"path": ["parameters", "1", "status"]
						},
						"description": "Desactiva un parametro (status=0)"
					}
				}
			]
		},
		{
			"name": "Parametros - Versionado",
			"item": [
				{
					"name": "GET - Historial de versiones",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/parameters/1/versions",
							"host": ["{{base_url}}"],
							"path": ["parameters", "1", "versions"]
						},
						"description": "Obtiene el historial de versiones de un parametro"
					}
				},
				{
					"name": "POST - Crear nueva version",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"value\": \"nuevo_valor\",\n    \"startDate\": \"2025-01-01\",\n    \"changeReason\": \"Motivo del cambio de valor\",\n    \"createdBy\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/parameters/1/versions",
							"host": ["{{base_url}}"],
							"path": ["parameters", "1", "versions"]
						},
						"description": "Crea una nueva version del parametro. Cierra la version actual y crea una nueva con el nuevo valor"
					}
				}
			]
		}
	]
}
