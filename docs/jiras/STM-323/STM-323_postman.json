{
  "info": {
    "name": "STM-323 — Facturas — Filtro Seguridad",
    "description": "Pruebas de filtro de seguridad por atributo de usuario en Facturas (fiscal-api).\nBFF fiscal: http://localhost:3003 | Backend: http://localhost:8082",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Escenario 1 — Proveedor único (fernando) → 4 registros",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-user-key", "value": "USR_FERNANDO" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"page\": 0,\n  \"size\": 20\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:3003/invoices/search",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3003",
          "path": ["invoices", "search"]
        },
        "description": "BFF resuelve ATR001=11111 para 'fernando'. Solo facturas del proveedor 11111. Esperado: 4 registros."
      }
    },
    {
      "name": "Escenario 2 — Múltiples proveedores (jose) → 8 registros",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-user-key", "value": "USR_JOSE" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"page\": 0,\n  \"size\": 20\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:3003/invoices/search",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3003",
          "path": ["invoices", "search"]
        },
        "description": "BFF resuelve ATR001=11111,22222 para 'jose'. Facturas 11111 ó 22222. Esperado: 8 registros."
      }
    },
    {
