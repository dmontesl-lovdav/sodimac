    {
      "name": "TAREA 3 - Cancelacion de NCs",
      "item": [
        {
          "name": "3.1 EXITO - Cancelar NC estatus 3 (Pend. Contabilizar)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroProveedor\": 12345,\n  \"estatusOrigen\": 3,\n  \"estatusDestino\": 10,\n  \"idUsuarioActualizacion\": 99999,\n  \"comentario\": \"STM-335: Cancelacion de NC desde estatus 3 (Pendiente de Contabilizar)\"\n}"
            },
            "url": {
              "raw": "http://localhost:8082/invoices/e0000001-0001-4001-e001-000000000001/status",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["invoices", "e0000001-0001-4001-e001-000000000001", "status"]
            },
            "description": "Cancela la NC/50001 que esta en estatus 3 (Pendiente de Contabilizar).\nProveedor: 12345 (JOH120507FU9)\n\nEsperado: HTTP 200 - Cancelacion exitosa\n- El estatus debe cambiar a 10 (Cancelada)\n\nNOTA: Esta prueba modifica datos. Ejecutar query 8 del SQL para verificar."
          },
          "response": []
        },
        {
          "name": "3.2 ERROR - Cancelar NC estatus 7 (Aplicado) -> WRN7023",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroProveedor\": 67890,\n  \"estatusOrigen\": 7,\n  \"estatusDestino\": 10,\n  \"idUsuarioActualizacion\": 99999,\n  \"comentario\": \"STM-335: Intento cancelar NC con afectacion contable\"\n}"
            },
            "url": {
