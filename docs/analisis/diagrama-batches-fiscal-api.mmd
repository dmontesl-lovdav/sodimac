flowchart TB
    subgraph FAPI["fiscal-api (NO tocado - solo validador/registro)"]
        DB[("BD tenant_fiscal<br/>invoice + status_train<br/>Tren v1.0 = fuente de verdad")]
        VAL["Valida cada transicion<br/>contra el tren v1.0<br/>(rechaza WRN7011 si no aplica)"]
    end

    subgraph FD["fiscal-download (Java 8 / SB 2.7)"]
        FD1["1. Busca facturas estatus 3 (Recibida)<br/>POST /invoices/search"]
        FD2["2. Descarga XML + desglosa CFDI<br/>escribe tablas SAP (Comprobante, Emisor...)"]
        FD3["3. PUT estatus: 3-4-5<br/>error estructura: 5-16 (reintenta 16-5)"]
    end

    subgraph ISS["invoice-status-sync (Java 17 / hexagonal)"]
        ISS1["1. Busca facturas estatus 7,8,9,10,11<br/>POST /invoices/search"]
        ISS2["2. Consulta sistemas reales:<br/>SAP Envios_Ap - SAPITO Oracle - i213 SP"]
        ISS3["3. PUT estatus: 7-8-9-10-11-12<br/>(14 rechazo, 17 error envio)"]
    end

    subgraph RAS["rebate-agreements-sync (Java 17 / hexagonal)"]
        RAS1["1. Descarga acuerdos comerciales<br/>API Azure rebate-management (paginado)"]
        RAS2["2. TRUNCATE + INSERT<br/>tabla RebateAcuerdosTemp"]
        RAS3["3. Trazabilidad CtrlProceso*<br/>(NO toca facturas)"]
    end

    EXT[("Sistemas externos<br/>SAP - SAPITO (Oracle) - i213")]
    AZ[("Azure<br/>rebate-management")]
    CTRL[("SODIMAC_BATCH_DEV<br/>CtrlProcesoCab/Det/Elemento/ctrlLog")]

    FD1 -->|"lee facturas en 3"| DB
    FD2 -->|"escribe desglose"| EXT
    FD3 -->|"actualiza estatus"| VAL
    VAL --> DB

    DB -.->|"5 Desglose a 7 Pend. registro SAPITO"| ISS1

    ISS1 -->|"lee facturas 7-11"| DB
    ISS2 -->|"registrada? enviada? contabilizada? pagada?"| EXT
    ISS3 -->|"actualiza estatus"| VAL

    RAS1 --> AZ
    RAS2 --> CTRL

    FD3 -.-> CTRL
    ISS3 -.-> CTRL

