{
  "info": {
    "_postman_id": "stm-829-payments-screen",
    "name": "STM-829 - Pantalla de Pagos",
    "description": "Coleccion para probar los servicios de consulta de pagos para la pantalla de Pagos del modulo financiero.\n\nEndpoints disponibles:\n- GET /fiscal/complementos-pago/buscar - Busqueda de pagos con filtros\n\nCriterios de Aceptacion:\n- CA-02: Fechas inicio y fin son obligatorias\n- CA-03: Numero de proveedor solo visible para admin\n- CA-04: Paginacion de 10 registros\n- CA-06: Exportacion de informacion (manejo en frontend)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "base_url_dev",
      "value": "https://fiscal-api-dev.sodimac.com",
      "type": "string"
    }
  ],
