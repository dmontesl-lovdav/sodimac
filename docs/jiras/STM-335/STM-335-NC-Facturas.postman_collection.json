              "raw": "{\n  \"rfcEmisor\": \"JOH120507FU9\",\n  \"fechaInicioRecepcion\": \"2025-01-01\",\n  \"fechaFinalRecepcion\": \"2026-12-31\",\n  \"tipoDocumento\": \"I\",\n  \"page\": 0,\n  \"size\": 20\n}"
            },
            "url": {
              "raw": "http://localhost:8082/invoices/search",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["invoices", "search"]
            },
            "description": "Busca facturas del emisor JOH120507FU9.\nLa factura FA/10002 (total 95,000) debe tener creditNotesCount=1."
          },
          "response": []
        }
      ]
    },
