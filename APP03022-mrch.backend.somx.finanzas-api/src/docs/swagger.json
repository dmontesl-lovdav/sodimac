    "/rebates/published": {
      "get": {
        "tags": [
          "Rebates"
        ],
        "summary": "Get published rebates",
        "description": "Retrieve all rebates with status = 2 (published)",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [],
        "responses": {
          "200": {
