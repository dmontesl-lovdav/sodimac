# =============================================================================
# UTILS-API - Configuracion de Entorno
# =============================================================================

# Puerto del servidor
PORT=3712
APP_PORT=3712

# Entorno
NODE_ENV=development

# Base de datos PostgreSQL (formato JDBC compatible con Spring Boot)
DATASOURCE_URL=jdbc:postgresql://localhost:5432/b2b_portal?currentSchema=core_utils&useSSL=false
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=postgres

# Trust proxy (para balanceadores de carga)
TRUST_PROXY=

# Titulo del servicio (para OpenAPI)
SERVICE_TITLE=Utils API - Herramientas y Utilerias

# =============================================================================
# Variables de Auditoria (modulo migrado desde auditoria-api - STM-1463)
# =============================================================================
# Esquema donde vive la tabla activity_logs (compartido con otros servicios)
# La entidad ActivityLogs apunta a core_audit.activity_logs independientemente
# del DB_SCHEMA principal del servicio (core_utils).
DB_AUDIT_SCHEMA=core_audit

# Nivel de log del logger de auditoria (pino): trace | debug | info | warn | error | fatal
LOG_LEVEL=info
