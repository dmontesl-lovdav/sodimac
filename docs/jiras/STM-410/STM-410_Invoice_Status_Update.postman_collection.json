            },
            "url": {
              "raw": "http://localhost:8082/invoices/search/by-status",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["invoices", "search", "by-status"]
            },
            "description": "Busca facturas pendientes de contabilizar.\n\nEsperado: HTTP 200"
          }
        },
        {
          "name": "1.3 Buscar NC con estatus=2",
          "request": {
