			<!-- 					<packageName>com.sodimac.fiscal.api.detecno.wsdl</packageName> -->
			<!-- 					<wsdlUrls> -->
			<!--
			<wsdlUrl>https://detecnorecepcion.mx:447/Recepcion/Validame/cfdiWSRecepcion_Servicio/Service1.svc?wsdl</wsdlUrl> -->
			<!-- 					</wsdlUrls> -->
			<!-- 					<sourceDestDir>${sourcesDir}</sourceDestDir> -->
			<!-- 					<destDir>${classesDir}</destDir> -->
			<!-- 					<extension>true</extension> -->
			<!-- 				</configuration> -->
			<!-- 			</plugin> -->
			<!-- 			<plugin> -->
			<!--                 <groupId>org.apache.maven.plugins</groupId> -->
			<!--                 <artifactId>maven-resources-plugin</artifactId> -->
			<!--             </plugin> -->

		</plugins>
	</build>
</project>