{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "NodeNext",
    "target": "ES2022",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "baseUrl": "./src",
    "paths": {
      "@/*": [
        "*"
      ],
      "@middlewares": [
        "middlewares/index.ts"
      ],
      "@middlewares/*": [
        "middlewares/*"
      ],
      "@controllers/*": [
        "controllers/*"
      ],
      "@routes/*": [
        "routes/*"
      ],
      "@schemas/*": [
        "schemas/*"
      ],
      "@services/*": [
        "services/*"
      ],
      "@utils/*": [
        "utils/*"
      ],
      "@lib/*": [
        "lib/*"
      ],
      "@entities/*": [
        "entities/*"
      ],
      "@providers/*": [
        "providers/*"
      ],
      "@models/*": [
        "models/*"
      ]
    },
    "types": [
      "node"
    ],
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/__tests__/**",
    "jest.config.cjs",
    "jest.config.js",
    "eslint.config.js",
    "nodemon.json"
  ]
}