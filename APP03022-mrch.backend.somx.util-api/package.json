{
  "name": "utils-api",
  "version": "1.0.0",
  "description": "API de Herramientas y Utilerias - Modulo de catalogos y parametros del sistema",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js,json --exec \"tsx -r tsconfig-paths/register src/server.ts\"",
    "start:dev": "tsx -r tsconfig-paths/register src/server.ts",
    "build": "rimraf dist && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "openapi:gen": "tsx -r tsconfig-paths/register scripts/gen-openapi.ts",
    "openapi:watch": "nodemon --watch src/docs --ext ts --exec \"npm run openapi:gen\"",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "typeorm": "tsx -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/config/typeorm-datasource.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "bash ./scripts/test-cov.sh"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cls-hooked": "^4.2.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jose": "^6.1.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.3",
    "pino": "^9.12.0",
    "pino-pretty": "^13.1.1",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27",
    "typeorm-transactional-cls-hooked": "^0.1.21",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.5.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "cross-env-shell": "^7.0.3",
    "eslint": "^9.36.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "openapi-types": "^12.1.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.4",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0"
  }
}