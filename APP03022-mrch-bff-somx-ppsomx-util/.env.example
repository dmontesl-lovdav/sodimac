# BFF Utils - Variables de entorno

# Puerto local del BFF
LOCAL_PORT=3800

# Contexto local (prefijo de rutas)
LOCAL_CONTEXT=/api/utils

# URL del backend utils-api
REMOTE_URL=http://localhost:3712

# Ruta de health check
HEALTH_PATH=/health

# Certificado publico para validacion JWT (base64)
AUTH_PUBLIC_KEY=
