{
  "info": {
    "name": "STM-1166 - Tren de Estatus",
    "description": "Coleccion de Postman para el servicio de gestion del tren de estatus.\n\nEndpoints para validar y administrar transiciones de estatus permitidas por opcion.\n\n**Opciones disponibles:**\n- 1 = Factura (I)\n- 2 = Nota de Credito (E)\n- 3 = Complemento de Pago (P)\n- 4 = CartaPorte (T)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Validacion de Transiciones",
      "item": [
        {
          "name": "1.1 Validar Transicion Permitida (3->4)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8083/status-train/validate?optionId=1&sourceStatus=3&targetStatus=4",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": ["status-train", "validate"],
              "query": [
                { "key": "optionId", "value": "1" },
                { "key": "sourceStatus", "value": "3" },
                { "key": "targetStatus", "value": "4" }
              ]
            },
            "description": "Valida si la transicion de estatus 3 -> 4 esta permitida para Facturas.\n\nEsperado: HTTP 200 con valid=true"
          }
        },
        {
          "name": "1.2 Validar Transicion NO Permitida (3->8)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8083/status-train/validate?optionId=1&sourceStatus=3&targetStatus=8",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": ["status-train", "validate"],
              "query": [
                { "key": "optionId", "value": "1" },
                { "key": "sourceStatus", "value": "3" },
                { "key": "targetStatus", "value": "8" }
              ]
            },
            "description": "Intenta validar una transicion que NO esta permitida (3 -> 8).\n\nEsperado: HTTP 400 con codigo WRN7011"
          }
        },
        {
          "name": "1.3 Validar Estatus Origen Inexistente (99->4)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8083/status-train/validate?optionId=1&sourceStatus=99&targetStatus=4",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": ["status-train", "validate"],
              "query": [
                { "key": "optionId", "value": "1" },
                { "key": "sourceStatus", "value": "99" },
                { "key": "targetStatus", "value": "4" }
              ]
            },
            "description": "Intenta validar con un estatus origen que no esta catalogado.\n\nEsperado: HTTP 400 con codigo WRN7010"
          }
        }
      ]
    },
