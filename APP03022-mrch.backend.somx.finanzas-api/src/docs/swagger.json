        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of rebates",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Rebate"
              }
