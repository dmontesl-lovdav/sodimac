              ]
            },
            "description": "Obtiene los destinos permitidos para NC desde PENDIENTE_ADDENDA.\n\nEsperado: [2, 3] (Recibido Parcial, Pendiente Contabilizar)"
          }
        },
        {
          "name": "2.5 Destinos - Estado Final COMPLETADO (10)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8083/status-train/allowed-destinations?optionId=1&sourceStatus=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": ["status-train", "allowed-destinations"],
              "query": [
                { "key": "optionId", "value": "1" },
                { "key": "sourceStatus", "value": "10" }
              ]
            },
            "description": "Consulta destinos desde COMPLETADO (10), que es un estado final.\n\nEsperado: HTTP 400 con WRN7010 (no hay transiciones desde este estado)"
          }
        }
      ]
    },
    {
      "name": "3. CRUD de Reglas",
      "item": [
        {
          "name": "3.1 Crear Nueva Regla (99->100)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"optionId\": 1,\n  \"sourceStatus\": 99,\n  \"targetStatus\": 100,\n  \"createdBy\": 1001\n}"
            },
            "url": {
              "raw": "http://localhost:8083/status-train",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": ["status-train"]
            },
            "description": "Crea una nueva regla de transicion (para pruebas).\n\nEsperado: HTTP 201 con la regla creada"
          }
        },
        {
          "name": "3.2 Obtener Regla por ID (1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8083/status-train/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": ["status-train", "1"]
            },
            "description": "Obtiene una regla especifica por su ID.\n\nEsperado: HTTP 200 con los datos de la regla"
          }
        },
        {
          "name": "3.3 Actualizar Regla (ID 1)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceStatus\": 99,\n  \"targetStatus\": 101,\n  \"updatedBy\": 1002\n}"
            },
            "url": {
              "raw": "http://localhost:8083/status-train/1?optionId=2",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": ["status-train", "1"],
              "query": [
                { "key": "optionId", "value": "2" }
              ]
            },
            "description": "Actualiza una regla existente.\n\nEsperado: HTTP 200 con la regla actualizada"
          }
        },
        {
          "name": "3.4 Eliminar Regla (ID 999)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:8083/status-train/999",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": ["status-train", "999"]
            },
            "description": "Elimina una regla de transicion.\n\nEsperado: HTTP 204 (sin contenido) o 404 si no existe"
          }
        }
      ]
    },
