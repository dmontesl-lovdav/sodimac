              "mode": "raw",
              "raw": "{\n  \"rfcEmisor\": \"{{rfc_emisor}}\",\n  \"fechaInicioRecepcion\": \"{{fecha_inicio}}\",\n  \"fechaFinalRecepcion\": \"{{fecha_fin}}\",\n  \"tipoDocumento\": \"I\",\n  \"page\": 0,\n  \"size\": 10\n}"
