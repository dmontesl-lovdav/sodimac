{
  "info": {
    "name": "STM-321 — Three Way Match — Filtro Seguridad",
    "description": "Pruebas de filtro de seguridad por atributo de usuario en Three Way Match.\nBFF: http://localhost:3000 | Backend: http://localhost:3001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Escenario 1 — Proveedor único (fernando)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-key", "value": "USR_FERNANDO" }
        ],
        "url": {
          "raw": "http://localhost:3000/three-way-match?tipoFecha=fechaRecepcion&fechaInicio=2024-01-01&fechaFin=2025-12-31",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["three-way-match"],
          "query": [
            { "key": "tipoFecha", "value": "fechaRecepcion" },
            { "key": "fechaInicio", "value": "2024-01-01" },
            { "key": "fechaFin", "value": "2025-12-31" }
          ]
        },
        "description": "BFF resuelve ATR001=1001 para el usuario 'fernando'. Solo devuelve registros del proveedor 1001."
      }
    },
    {
      "name": "Escenario 2 — Múltiples proveedores (jose)",
