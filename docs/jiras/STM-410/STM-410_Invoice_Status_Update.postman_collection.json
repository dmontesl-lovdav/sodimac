            },
            "url": {
              "raw": "http://localhost:8082/invoices/search/by-status",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["invoices", "search", "by-status"]
            },
            "description": "Busca notas de credito filtrando por estatus obligatorio.\n\nEsperado: HTTP 200"
          }
