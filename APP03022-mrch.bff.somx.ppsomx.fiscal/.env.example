# Configuración Local para BFF Fiscal-API
# El backend fiscal-api debe estar corriendo en localhost:8082

# Puerto del servicio fiscal-api backend (por defecto 8082)
FISCAL_API_PORT=8082

# URL del servicio fiscal-api backend
REMOTE_URL=http://localhost:8082

# Puerto donde escuchará el proxy BFF
LOCAL_PORT=3000

# Contexto local del proxy (configuración estándar BFF)
LOCAL_CONTEXT=/

# Path para health check
HEALTH_PATH=/health

# Certificado público de KeyCloak (opcional para pruebas locales)
# Por ahora está comentado en App.js líneas 48-52
# IMPORTANTE: Para desarrollo local sin autenticación, agregar header:
# Authorization: Bearer dummy-token
AUTH_PUBLIC_KEY=
