                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceUuids\": [\n    \"uuid-factura-1\",\n    \"uuid-factura-2\"\n  ]\n}"
            },
            "url": {
              "raw": "{{fiscal_api_url}}/invoices/download/xml",
              "host": ["{{fiscal_api_url}}"],
              "path": ["invoices", "download", "xml"]
            },
            "description": "Descarga masiva de XMLs en ZIP"
          },
          "response": []
        },
        {
          "name": "5.2 Descargar PDF (Masivo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
