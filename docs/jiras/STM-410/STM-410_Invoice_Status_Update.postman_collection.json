{
  "info": {
    "_postman_id": "stm-410-invoice-status-update",
    "name": "STM-410 - Actualizacion de Estatus con Validacion",
    "description": "Coleccion para probar los endpoints de STM-410:\n- Busqueda de facturas por estatus (obligatorio)\n- Actualizacion de estatus con validacion de transicion\n\nRequiere que el servicio de catalogos-api este corriendo con STM-1166 implementado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Busqueda por Estatus",
      "item": [
        {
          "name": "1.1 Buscar facturas con estatus=1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rfcEmisor\": \"SOD970101ABC\",\n  \"fechaInicioRecepcion\": \"2025-08-01\",\n  \"fechaFinalRecepcion\": \"2026-01-31\",\n  \"tipoDocumento\": \"I\",\n  \"estatus\": 1,\n  \"page\": 0,\n  \"size\": 20,\n  \"sortBy\": \"createdAt\",\n  \"sortDirection\": \"DESC\"\n}"
            },
            "url": {
              "raw": "http://localhost:8082/invoices/search/by-status",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["invoices", "search", "by-status"]
            },
            "description": "Busca facturas filtrando por estatus obligatorio.\n\nEl campo 'estatus' es obligatorio en esta busqueda.\n\nEsperado: HTTP 200 con lista de facturas"
          }
        },
        {
          "name": "1.2 Buscar facturas con estatus=3",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
