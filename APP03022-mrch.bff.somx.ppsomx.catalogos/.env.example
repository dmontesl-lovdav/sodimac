# Configuracion Local para BFF Catalogos-API
# El backend catalogos-api debe estar corriendo en localhost:8083

# URL del servicio catalogos-api backend
REMOTE_URL=http://localhost:8083

# Puerto donde escuchara el proxy BFF
LOCAL_PORT=3000

# Contexto local del proxy (configuracion estandar BFF)
LOCAL_CONTEXT=/

# Path para health check
HEALTH_PATH=/health
