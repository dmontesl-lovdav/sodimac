          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Status code (e.g. 1=open, 2=closed)",
            "type": "integer"
          },
          {
            "name": "vendorNumber",
            "in": "query",
            "required": false,
            "description": "Vendor number identifier",
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "List of accounts payable",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/AccountsPayable"
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "AccountsPayable"
        ],
        "summary": "Create account payable",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CreateAccountsPayableDto"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/components/schemas/AccountsPayable"
            }
          }
        }
      }
    },
