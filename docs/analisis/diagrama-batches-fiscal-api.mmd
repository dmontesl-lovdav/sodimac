flowchart TB

    subgraph TREN["TREN DE ESTATUS v1.0 - fuente de verdad: shared_catalogs.status_train (fiscal-api valida cada salto)"]
        direction LR
        S3["3<br/>Recibida"]:::fd --> S4["4<br/>En proceso<br/>de descarga"]:::fd --> S5["5<br/>Desglose<br/>de factura"]:::fd
        S5 --> S7["7<br/>Pend. registro<br/>SAPITO"]:::iss --> S8["8<br/>Pend. envio<br/>a i213"]:::iss --> S9["9<br/>Factura<br/>enviada i213"]:::iss
        S9 --> S10["10<br/>Pend.<br/>contabilizar"]:::iss --> S11["11<br/>Pend.<br/>de Pago"]:::iss --> S12["12<br/>Pend.<br/>complemento"]:::iss --> S13["13<br/>Completado"]:::done
        S5 -. "error estructura" .-> S16["16<br/>Estructura<br/>invalida"]:::err
        S16 -. "reintenta" .-> S5
        S9 -. "no enviada" .-> S17["17<br/>Error envio i213"]:::err
        S10 -. "rechazo" .-> S14["14<br/>Rechazo<br/>Contable"]:::err
    end

    subgraph ORD["ORDEN DE EJECUCION"]
        direction LR
        O1["rebate-agreements-sync<br/>cron 03:00 (independiente, otro dominio)"]:::ras
        O2["fiscal-download<br/>recepcion (one-shot .bat)"]:::fd
        O3["invoice-status-sync<br/>cron 07:30"]:::iss
        O2 -->|"handoff: factura desglosada (5) pasa a registro SAPITO (7)"| O3
    end

    FAPI["fiscal-api  :8082  (NO tocado - solo validador/registro)<br/>BD Postgres tenant_fiscal :5434<br/>Guarda invoice + valida transicion vs tren v1.0 (WRN7011 si no aplica)"]:::api

    FD["fiscal-download  (Java 8 / SB 2.7, sin web)<br/>DUENO estatus 3 -> 4 -> 5  (+16 error)<br/>Baja XML, desglosa CFDI, escribe tablas SAP"]:::fd
    ISS["invoice-status-sync  :8085  (Java 17 / hexagonal)<br/>DUENO estatus 7 -> 8 -> 9 -> 10 -> 11 -> 12  (+14,+17)<br/>Pregunta a SAP / SAPITO / i213 reales"]:::iss
    RAS["rebate-agreements-sync  :8086  (Java 17 / hexagonal)<br/>Baja convenios -> tabla RebateAcuerdosTemp<br/>NO toca facturas"]:::ras

    SAP[("SAP + i213 (SQL Server)<br/>10.138.153.10:1433 (local :1434)<br/>Envios_Ap + SP i123/i213")]
    ORA[("SAPITO (Oracle)<br/>ensenada:1541 (local :1521)<br/>Envios_Ap (FLAG_ENVIADO)")]
    AZ[("Azure rebate-management<br/>HTTPS (paginado)")]
    CTRL[("SODIMAC_BATCH_DEV (SQL Server)<br/>CtrlProcesoCab / Det / Elemento / ctrlLog")]

