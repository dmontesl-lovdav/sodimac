				{
					"name": "Obtener todos los catalogos",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/",
							"host": ["{{base_url}}"],
							"path": [""]
						},
						"description": "Obtiene la lista de todos los catalogos disponibles en el sistema."
					},
					"response": []
				},
