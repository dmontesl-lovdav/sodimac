              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rfcEmisor\": \"SOD970101ABC\",\n  \"fechaInicioRecepcion\": \"2025-08-01\",\n  \"fechaFinalRecepcion\": \"2026-01-31\",\n  \"tipoDocumento\": \"I\",\n  \"page\": 0,\n  \"size\": 20\n}"
            },
            "url": {
