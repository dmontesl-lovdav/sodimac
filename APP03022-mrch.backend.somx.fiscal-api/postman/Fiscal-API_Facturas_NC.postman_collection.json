    },
    {
      "name": "4. Flujo Completo - Ciclo de Vida de Factura",
      "item": [
        {
          "name": "4.1 Paso 1: Buscar facturas pendientes de contabilizar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rfcEmisor\": \"JOH120507FU9\",\n  \"fechaInicioRecepcion\": \"2025-07-01\",\n  \"fechaFinalRecepcion\": \"2025-12-31\",\n  \"tipoDocumento\": \"I\",\n  \"estatus\": 3,\n  \"idProveedor\": 12345,\n  \"page\": 0,\n  \"size\": 10\n}"
            },
            "url": {
              "raw": "http://localhost:8082/invoices/search/by-status",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["invoices", "search", "by-status"]
            },
            "description": "Paso 1: Buscar facturas de un proveedor especifico en estatus 3 (Pendiente de Contabilizar)"
          }
        },
        {
          "name": "4.2 Paso 2: Mover a Proceso de Descarga (3 -> 4)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
