# =============================================================================
# UTILS-API - Configuracion de Entorno
# =============================================================================

# Puerto del servidor
PORT=3712
APP_PORT=3712

# Entorno
NODE_ENV=development

# Base de datos PostgreSQL (formato JDBC compatible con Spring Boot)
DATASOURCE_URL=jdbc:postgresql://localhost:5432/b2b_portal?currentSchema=core_utils&useSSL=false
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=postgres

# Trust proxy (para balanceadores de carga)
TRUST_PROXY=

# Titulo del servicio (para OpenAPI)
SERVICE_TITLE=Utils API - Herramientas y Utilerias
