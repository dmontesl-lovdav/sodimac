# Configuracion Local para BFF Auditoria-API
# El backend auditoria-api debe estar corriendo en localhost:8091

# URL del servicio auditoria-api backend
REMOTE_URL=http://localhost:8091

# Puerto donde escuchara el proxy BFF
LOCAL_PORT=3008

# Contexto local del proxy (configuracion estandar BFF)
LOCAL_CONTEXT=/

# Path para health check
HEALTH_PATH=/health

# Certificado publico de KeyCloak (opcional para pruebas locales)
# Por ahora esta comentado en App.js lineas 47-51
AUTH_PUBLIC_KEY=
